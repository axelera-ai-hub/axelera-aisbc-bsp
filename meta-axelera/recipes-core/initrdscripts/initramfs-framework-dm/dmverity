#!/bin/sh

dmverity_enabled() {
    return 0
}

dmverity_run() {
    DATA_SIZE="__not_set__"
    DATA_BLOCK_SIZE="__not_set__"
    ROOT_HASH="__not_set__"

    [ -f /usr/share/misc/dm-verity.env ] && . /usr/share/misc/dm-verity.env

    C=0
    delay=${bootparam_rootdelay:-1}
    timeout=${bootparam_roottimeout:-5}

    # A/B slots share a PARTUUID and a filesystem UUID, so neither can be
    # used to pick a slot. Use the per-slot partition label instead.
    SLOT="$(sed -n 's/.*androidboot\.slot_suffix=\([^ ]*\).*/\1/p' /proc/cmdline)"
    case "${SLOT}" in
        _a|_b) ;;
        *)
            fatal "androidboot.slot_suffix='${SLOT}' missing or invalid"
            exit 1
            ;;
    esac
    ROOT_PARTLABEL="system${SLOT}"
    msg "Selecting rootfs by partition label ${ROOT_PARTLABEL}"

    RDEV="$(realpath /dev/disk/by-partlabel/${ROOT_PARTLABEL} 2>/dev/null)"
    while [ ! -b "${RDEV}" ]; do
        if [ $(( $C * $delay )) -gt $timeout ]; then
            fatal "Root device ${ROOT_PARTLABEL} resolution failed"
            exit 1
        fi

        debug "Sleeping for $delay second(s) to wait root to settle..."
        sleep $delay
        C=$(( $C + 1 ))

        RDEV="$(realpath /dev/disk/by-partlabel/${ROOT_PARTLABEL} 2>/dev/null)"
    done

    # Images built without dm-verity carry no root hash; plain-mount those so
    # that one initramfs serves both build types.
    if [ "${ROOT_HASH}" = "__not_set__" ]; then
        msg "No root hash present; mounting ${RDEV} without dm-verity"
        mount -o ro "${RDEV}" "${ROOTFS_DIR}" || exit 2
        return
    fi

    veritysetup \
        --data-block-size=${DATA_BLOCK_SIZE} \
        --hash-offset=${DATA_SIZE} \
        create rootfs \
        ${RDEV} \
        ${RDEV} \
        ${ROOT_HASH}

    mount \
        -o ro \
        /dev/mapper/rootfs \
        ${ROOTFS_DIR} || exit 2
}
