From d6341d0800c137ca9fe11611cb3416c3d96c91a3 Mon Sep 17 00:00:00 2001
From: kas User <kas@example.com>
Date: Tue, 29 Sep 2026 14:54:41 +0200
Subject: [PATCH] avbtool: Hardcode dm argument

Always restart on corruption

Signed-off-by: Annachiara Gallo <annachiara.gallo@amarulasolutions.com>
---
 avbtool.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/avbtool.py b/avbtool.py
index c0f3c7c..ab87566 100755
--- a/avbtool.py
+++ b/avbtool.py
@@ -3280,7 +3280,7 @@ class Avb(object):
         c += ' check_at_most_once'
       else:
         c += ' 10'  # number of optional args
-      c += ' $(ANDROID_VERITY_MODE)'
+      c += ' restart_on_corruption'
       c += ' ignore_zero_blocks'
       c += ' use_fec_from_device PARTUUID=$(ANDROID_SYSTEM_PARTUUID)'
       c += ' fec_roots {}'.format(ht.fec_num_roots)
@@ -3295,7 +3295,7 @@ class Avb(object):
         c += ' check_at_most_once'
       else:
         c += ' 2'  # number of optional args
-      c += ' $(ANDROID_VERITY_MODE)'
+      c += ' restart_on_corruption'
       c += ' ignore_zero_blocks'
     c += '" root=/dev/dm-0'
 
