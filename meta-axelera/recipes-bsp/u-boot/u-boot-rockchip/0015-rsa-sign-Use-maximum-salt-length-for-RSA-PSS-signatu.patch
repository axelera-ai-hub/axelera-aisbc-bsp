From 57ef0a663a9b9b4dbbbff737895cabfda8efd0cd Mon Sep 17 00:00:00 2001
From: Patrick Barsanti <patrick.barsanti@amarulasolutions.com>
Date: Wed, 28 Oct 2026 13:05:47 +0100
Subject: [PATCH] rsa-sign: Use maximum salt length for RSA-PSS signatures

padding_pss_verify() gets the salt length with msg_len - hash_len - 2,
so it only accepts signatures made with the maximum salt length.

rsa_sign_with_key() selects PSS padding but leaves the salt length at
OpenSSL default. This worked with older OpenSSL versions because they
defaulted to the maximum. Newer ones, however, default to digest length.

This produces a signature that causes the following error:

| Signature check Bad (error 1)
| Verifying Hash Integrity ... sha256,rsa2048:devpadding_pss_verify: invalid pss padding (leftmost byte of db isn't 0x01)
| padding_pss_verify: invalid pss padding (leftmost byte of db isn't 0x01)

Fix this by setting the salt length explicitly, so that signing matches
verification regardless of the host OpenSSL version.

Upstream-Status: Pending
Signed-off-by: Patrick Barsanti <patrick.barsanti@amarulasolutions.com>
---
 lib/rsa/rsa-sign.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/lib/rsa/rsa-sign.c b/lib/rsa/rsa-sign.c
index 71a940c779..d24189ce92 100644
--- a/lib/rsa/rsa-sign.c
+++ b/lib/rsa/rsa-sign.c
@@ -468,6 +468,16 @@ static int rsa_sign_with_key(RSA *rsa, struct padding_algo *padding_algo,
 			ret = rsa_err("Signer padding setup failed");
 			goto err_sign;
 		}
+
+		/*
+		 * padding_pss_verify() only accepts the maximum salt length.
+		 * Newer OpenSSL versions default to the digest length.
+		 */
+		if (EVP_PKEY_CTX_set_rsa_pss_saltlen(ckey,
+						     RSA_PSS_SALTLEN_MAX) <= 0) {
+			ret = rsa_err("Signer salt length setup failed");
+			goto err_sign;
+		}
 	}
 #endif /* CONFIG_FIT_ENABLE_RSASSA_PSS_SUPPORT */
 
